# --- Production (real mainnet) ---
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_CHAIN_NAME=Ethereum
# Point the browser transport at the server-side proxy so your RPC key is never exposed:
NEXT_PUBLIC_RPC_URL=/api/rpc
NEXT_PUBLIC_BIDS_ADDRESS=0xYourDeployedArtificialBids
NEXT_PUBLIC_GENESIS_ADDRESS=0xa7a3022249415e25752C4cF8696c2418DEfdF2Db
NEXT_PUBLIC_WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Free project id from https://cloud.reown.com to enable WalletConnect:
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: GitHub repo link shown in the footer (leave blank to hide it):
NEXT_PUBLIC_GITHUB_URL=
# Optional: canonical site URL used for WalletConnect metadata (defaults to the runtime origin):
NEXT_PUBLIC_SITE_URL=

# --- SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix -> never shipped to the browser) ---
# The real, keyed RPC endpoint that /api/rpc forwards to:
RPC_URL=https://eth-mainnet.your-provider.example/v2/YOUR_KEY
# Etherscan v2 API key that /api/etherscan injects server-side:
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# ETHERSCAN_CHAIN_ID=1

# --- Local demo only (leave unset in production) ---
# NEXT_PUBLIC_DEMO_ACCOUNTS=Seller:0xf39...266,Bidder:0x709...C8
# NEXT_PUBLIC_DEMO_PIECE=0xbDF5A7F5e5AE18eE580139297C63a89fc1d18B5f
